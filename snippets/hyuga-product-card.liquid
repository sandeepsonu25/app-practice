{% doc %}
  Hyuga product card.

  @param {string} title - Product title
  @param {string} image - Image URL
  @param {string} price - Selling price
  @param {string} compare - Compare at price
  @param {string} off - Discount percent
  @param {string} rating - Star rating
  @param {string} [url] - Optional product URL
{% enddoc %}
{%- if url != blank -%}
  <a class="hyuga-card" href="{{ url }}">
{%- else -%}
  <div class="hyuga-card">
{%- endif -%}
  <div class="hyuga-card__img">
    <img src="{{ image }}" alt="{{ title | escape }}" width="100%" height="auto" loading="lazy">
  </div>
  {%- if off != blank and off != 0 and off != '0' -%}
    <span class="hyuga-card__off">{{ off }}% Off</span>
  {%- endif -%}
  <div class="hyuga-card__title">{{ title }}</div>
  <div class="hyuga-card__rating">★ {{ rating }}</div>
  <div class="hyuga-card__price">
    <b>₹{{ price }}</b>
    {%- if compare != blank -%}<s>₹{{ compare }}</s>{%- endif -%}
  </div>
  <span class="hyuga-card__add">Add to Cart</span>
{%- if url != blank -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

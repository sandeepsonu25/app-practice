<div class="hyuga-app">
  <div class="hyuga-wrap">
    <div class="hyuga-bubbles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign src = block.settings.image_url
          if block.settings.image != blank
            assign src = block.settings.image | image_url: width: 200
          endif
        -%}
        <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} class="hyuga-bubble" {{ block.shopify_attributes }}>
          <img src="{{ src }}" alt="{{ block.settings.label | escape }}" width="78" height="78" loading="lazy">
          {%- if block.settings.label != blank -%}
            <span>{{ block.settings.label }}</span>
          {%- endif -%}
        </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hyuga category bubbles",
  "tag": "section",
  "class": "hyuga-section-root",
  "settings": [],
  "blocks": [
    {
      "type": "bubble",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL fallback" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Hyuga category bubbles" }]
}
{% endschema %}

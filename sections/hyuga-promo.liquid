<div class="hyuga-app">
  <div class="hyuga-wrap">
    {% comment %} {%- if section.settings.mobile_image != blank or section.settings.mobile_url != blank -%}
      {%- liquid
        assign msrc = section.settings.mobile_url
        if section.settings.mobile_image != blank
          assign msrc = section.settings.mobile_image | image_url: width: 1000
        endif
      -%}
      <{% if section.settings.mobile_link != blank %}a href="{{ section.settings.mobile_link }}"{% else %}div{% endif %} class="hyuga-mobile-only hyuga-promo-mobile">
        <img src="{{ msrc }}" alt="{{ section.settings.mobile_alt | escape }}" width="800" height="220">
      </{% if section.settings.mobile_link != blank %}a{% else %}div{% endif %}>
    {%- endif -%} {% endcomment %}

    <div class="hyuga-pair">
      {%- for block in section.blocks -%}
        {%- liquid
          assign src = block.settings.image_url
          if block.settings.image != blank
            assign src = block.settings.image | image_url: width: 1200
          endif
        -%}
        <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} {{ block.shopify_attributes }}>
          <img src="{{ src }}" alt="{{ block.settings.alt | escape }}" width="800" height="220" loading="lazy">
        </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hyuga promo banners",
  "settings": [
    { "type": "header", "content": "Mobile banner" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    {
      "type": "text",
      "id": "mobile_url",
      "label": "Mobile image URL fallback",
      "default": "https://cdn.hyugalife.com/assets/images/stack/stackquiz-cta-mweb.png"
    },
    {
      "type": "text",
      "id": "mobile_alt",
      "label": "Mobile alt text",
      "default": "Build your personalized supplement stack"
    },
    { "type": "url", "id": "mobile_link", "label": "Mobile link (optional)" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Desktop banner",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL fallback" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Promo" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Hyuga promo banners" }]
}
{% endschema %}

{{ 'hyuga-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout
-%}

<div class="hyuga-app">
  <div class="hyuga-wrap">
    <section class="hyuga-section">
      {%- if section.settings.heading != blank -%}
        <div class="hyuga-section__head">
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if layout == 'rail' -%}
        <div class="hyuga-rail">
          {%- for block in section.blocks -%}
            {%- liquid
              assign src = block.settings.image_url
              if block.settings.image != blank
                assign src = block.settings.image | image_url: width: 800
              endif
            -%}
            <a
              class="{% if section.settings.card_style == 'offer' %}hyuga-offer{% elsif section.settings.card_style == 'category' %}hyuga-cat-card{% else %}hyuga-offer{% endif %}"
              href="{{ block.settings.link }}"
              {{ block.shopify_attributes }}
            >
              <img src="{{ src }}" alt="{{ block.settings.title | escape }}" width="320" height="220">
              {%- if section.settings.card_style == 'category' and block.settings.title != blank -%}
                <span>{{ block.settings.title }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="{{ layout }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign src = block.settings.image_url
              if block.settings.image != blank
                assign src = block.settings.image | image_url: width: 900
              endif
            -%}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              <img src="{{ src }}" alt="{{ block.settings.title | escape }}" width="400" height="400">
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Hyuga image row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rail", "label": "Horizontal slider" },
        { "value": "hyuga-focus", "label": "Grid 4" },
        { "value": "hyuga-brand-grid", "label": "Brand grid" },
        { "value": "hyuga-pantry-grid", "label": "Tall grid" },
        { "value": "hyuga-protein-grid", "label": "Protein grid" },
        { "value": "hyuga-deal-grid", "label": "Deal grid" }
      ],
      "default": "rail"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Slider card style",
      "options": [
        { "value": "offer", "label": "Offer / banner" },
        { "value": "category", "label": "Category with title" }
      ],
      "default": "offer"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hyuga image row"
    }
  ]
}
{% endschema %}

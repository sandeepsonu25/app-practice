{%- liquid
  assign use_blog = false
  if section.settings.blog != blank and section.settings.blog.articles_count > 0
    assign use_blog = true
  endif
-%}

<div class="hyuga-app">
  <div class="hyuga-wrap">
    <section class="hyuga-blog" data-hyuga-blog>
      <div class="hyuga-section__head">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {% if section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span aria-hidden="true">›</span></a>
          {% elsif use_blog %}
            <a href="{{ section.settings.blog.url }}">{{ section.settings.button_label }} <span aria-hidden="true">›</span></a>
          {% else %}
            <span>{{ section.settings.button_label }} <span aria-hidden="true">›</span></span>
          {% endif %}
        {%- endif -%}
      </div>

      <div class="hyuga-blog__viewport">
        <div class="hyuga-blog__rail hyuga-rail" data-hyuga-blog-rail>
          {%- if use_blog -%}
            {%- for article in section.settings.blog.articles limit: section.settings.limit -%}
              <a class="hyuga-blog-card" href="{{ article.url }}">
                <div class="hyuga-blog-card__media">
                  {%- if article.image != blank -%}
                    <img
                      src="{{ article.image | image_url: width: 720 }}"
                      alt="{{ article.title | escape }}"
                      width="360"
                      height="200"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="hyuga-blog-card__placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="hyuga-blog-card__body">
                  <h3 class="hyuga-blog-card__title">{{ article.title }}</h3>
                  <p class="hyuga-blog-card__excerpt">
                    {%- if article.excerpt != blank -%}
                      {{ article.excerpt | strip_html | truncate: 90 }}
                    {%- else -%}
                      {{ article.content | strip_html | truncate: 90 }}
                    {%- endif -%}
                  </p>
                  <p class="hyuga-blog-card__author">By {{ article.author }}</p>
                </div>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign src = block.settings.image_url
                if block.settings.image != blank
                  assign src = block.settings.image | image_url: width: 720
                endif
              -%}
              <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
                class="hyuga-blog-card"
                {{ block.shopify_attributes }}
              >
                <div class="hyuga-blog-card__media">
                  {%- if src != blank -%}
                    <img src="{{ src }}" alt="{{ block.settings.title | escape }}" width="360" height="200" loading="lazy">
                  {%- else -%}
                    <div class="hyuga-blog-card__placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="hyuga-blog-card__body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="hyuga-blog-card__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.excerpt != blank -%}
                    <p class="hyuga-blog-card__excerpt">{{ block.settings.excerpt }}</p>
                  {%- endif -%}
                  {%- if block.settings.author != blank -%}
                    <p class="hyuga-blog-card__author">By {{ block.settings.author }}</p>
                  {%- endif -%}
                </div>
              </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <button type="button" class="hyuga-blog__next" data-hyuga-blog-next aria-label="Next articles">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Hyuga blog rail",
  "tag": "section",
  "class": "hyuga-section-root",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Easy Reads, Practical Advice"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "View all link"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "If set and has posts, articles are shown instead of manual blocks"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,

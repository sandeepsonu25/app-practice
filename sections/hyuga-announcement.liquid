{%- if section.settings.text != blank -%}
  <div
    class="hyuga-app hyuga-announcement"
    style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"
  >
    <div class="hyuga-wrap hyuga-announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="hyuga-announcement__text">{{ section.settings.text }}</a>
      {%- else -%}
        <span class="hyuga-announcement__text">{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hyuga announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "SALE IS LIVE! | Up to 60% OFF* | Extra 8% Off with Dhamaka8* | 100% Authentic Products |"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#1A1A5E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [{ "name": "Hyuga announcement" }]
}
{% endschema %}

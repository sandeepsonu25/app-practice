<div class="hyuga-app">
  <div class="hyuga-wrap">
    <section class="hyuga-section hyuga-purpose" data-hyuga-purpose>
      {%- if section.settings.heading != blank -%}
        <div class="hyuga-section__head">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      <div class="hyuga-purpose__viewport">
        <div class="hyuga-purpose__rail hyuga-rail" data-hyuga-purpose-rail>
          {%- for block in section.blocks -%}
            {%- liquid
              assign src = block.settings.image_url
              if block.settings.image != blank
                assign src = block.settings.image | image_url: width: 900
              endif
              assign has_overlay = false
              if block.settings.line_1 != blank or block.settings.line_3 != blank
                assign has_overlay = true
              endif
            -%}
            <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
              class="hyuga-purpose__card{% if has_overlay %} hyuga-purpose__card--overlay{% endif %}"
              style="{% if block.settings.bg_from != blank or block.settings.bg_to != blank %}--purpose-from:{{ block.settings.bg_from | default: '#dbeafe' }};--purpose-to:{{ block.settings.bg_to | default: '#93c5fd' }};{% endif %}{% if block.settings.text_color != blank %}--purpose-text:{{ block.settings.text_color }};{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if src != blank -%}
                <img
                  class="hyuga-purpose__img"
                  src="{{ src }}"
                  alt="{{ block.settings.line_3 | default: block.settings.line_1 | escape }}"
                  width="480"
                  height="240"
                  loading="lazy"
                >
              {%- endif -%}

              {% comment %} {%- if has_overlay -%}
                <div class="hyuga-purpose__text">
                  {%- if block.settings.line_1 != blank -%}
                    <span class="hyuga-purpose__line1">{{ block.settings.line_1 }}</span>
                  {%- endif -%}
                  {%- if block.settings.line_2 != blank -%}
                    <span class="hyuga-purpose__line2">{{ block.settings.line_2 }}</span>
                  {%- endif -%}
                  {%- if block.settings.line_3 != blank -%}
                    <span class="hyuga-purpose__line3">{{ block.settings.line_3 }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%} {% endcomment %}
            </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <button
            type="button"
            class="hyuga-purpose__next"
            data-hyuga-purpose-next
            aria-label="Next"
          >
          
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        {%- endif -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Hyuga purpose banners",
  "tag": "section",
  "class": "hyuga-section-root",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Purpose-Built Supplements"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Banner image" },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback",
          "info": "Use a full designed banner, or a product image with the text fields below"
        },
        {
          "type": "header",
          "content": "Optional text overlay"
        },
        { "type": "text", "id": "line_1", "label": "Top line" },
        { "type": "text", "id": "line_2", "label": "Middle line", "default": "with" },
        { "type": "text", "id": "line_3", "label": "Bottom line" },
        { "type": "color", "id": "bg_from", "label": "Gradient start", "default": "#DBEAFE" },
        { "type": "color", "id": "bg_to", "label": "Gradient end", "default": "#93C5FD" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#1E3A8A" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hyuga purpose banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "image_url": "https://cdn.hyugalife.com/banner/feature/Glutathione_16_3.png"
          }
        },
        {
          "type": "banner",
          "settings": {
            "image_url": "https://cdn.hyugalife.com/banner/feature/Magnesium_2.png"
          }
        },
        {
          "type": "banner",
          "settings": {
            "image_url": "https://cdn.hyugalife.com/banner/feature/Collagen_50_1.png"
          }
        },
        {
          "type": "banner",
          "settings": {
            "image_url": "https://cdn.hyugalife.com/banner/feature/ACV-2.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
